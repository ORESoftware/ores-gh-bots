{
  "$schema": "./secrets.schema.json",
  "version": 1,
  "encryptedSource": "env/enc/review-bots.env",
  "plaintextDestination": "env/dec/review-bots.env",
  "deployment": {
    "provider": "kubernetes",
    "namespace": "ores-gh-bots",
    "secretName": "ores-gh-bots-secrets"
  },
  "requiredKeys": [
    "GITHUB_WEBHOOK_SECRET",
    "GITHUB_APP_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "OPENAI_REVIEW_APP_ID",
    "OPENAI_REVIEW_APP_PRIVATE_KEY",
    "CLAUDE_REVIEW_APP_ID",
    "CLAUDE_REVIEW_APP_PRIVATE_KEY",
    "GATE_APP_ID",
    "GATE_APP_PRIVATE_KEY",
    "ACTIONS_APP_ID",
    "ACTIONS_APP_PRIVATE_KEY",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY"
  ],
  "rotation": {
    "preserveAppIdentity": true,
    "preserveQueueStorage": true,
    "privateKeyOverlapRequired": true
  }
}
