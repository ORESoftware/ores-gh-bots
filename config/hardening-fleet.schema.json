{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oresoftware.dev/schema/fleet-hardening/v1",
  "title": "ORES fleet hardening configuration",
  "type": "object",
  "required": ["api_version", "central", "defaults", "organizations"],
  "properties": {
    "api_version": { "const": "ores.dev/fleet-hardening/v1" },
    "central": { "type": "object", "minProperties": 1 },
    "defaults": { "type": "object", "minProperties": 1 },
    "organizations": {
      "type": "array",
      "minItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "namespace", "environment"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
          "environment": { "enum": ["production", "test"] },
          "test_organization": { "type": "string" },
          "production_organization": { "type": "string" },
          "policy_repository": { "type": "string" },
          "policy_path": { "type": "string" },
          "repository_scope": { "type": "object" },
          "required_capabilities": { "type": "array", "items": { "type": "string" } },
          "required_checks": { "type": "array", "items": { "type": "string" } },
          "repository_roles": { "type": "array", "items": { "type": "string" } },
          "required_repositories": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "description": { "type": "string" },
                    "private": { "type": "boolean" },
                    "visibility": { "enum": ["public", "private", "internal"] }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "sql": { "type": "object" },
          "infrastructure": { "type": "object" },
          "observability": { "type": "object" },
          "dependency_management": { "type": "object" },
          "promotion": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
