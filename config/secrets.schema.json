{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/ores-gh-bots/blob/main/config/secrets.schema.json",
  "title": "ORES encrypted secret inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "encryptedSource",
    "plaintextDestination",
    "deployment",
    "requiredKeys",
    "rotation"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "encryptedSource": {
      "const": "env/enc/review-bots.env"
    },
    "plaintextDestination": {
      "const": "env/dec/review-bots.env"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "namespace",
        "secretName"
      ],
      "properties": {
        "provider": {
          "const": "kubernetes"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requiredKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserveAppIdentity",
        "preserveQueueStorage",
        "privateKeyOverlapRequired"
      ],
      "properties": {
        "preserveAppIdentity": {
          "const": true
        },
        "preserveQueueStorage": {
          "const": true
        },
        "privateKeyOverlapRequired": {
          "const": true
        }
      }
    }
  }
}
