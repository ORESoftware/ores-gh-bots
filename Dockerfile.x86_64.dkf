# syntax=docker/dockerfile:1.7
# ores-expected-target: linux/amd64
ARG TARGETPLATFORM
FROM --platform=$TARGETPLATFORM node:22.16.0-bookworm-slim AS runtime

ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
RUN test "${TARGETOS:?TARGETOS is required}" = "linux" \
    && test "${TARGETARCH:?TARGETARCH is required}" = "amd64"

WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY config ./config
COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh
RUN mkdir -p /data \
    && chown -R node:node /app /data
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "apps/orchestrator/src/main.mjs"]
