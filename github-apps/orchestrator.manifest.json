{
  "name": "ORES Review Orchestrator",
  "url": "https://github.com/ORESoftware/ores-gh-bots",
  "hook_attributes": {"url": "https://replace.example/webhooks/github", "active": true},
  "redirect_url": "https://replace.example/github/app-manifest/callback",
  "public": false,
  "default_permissions": {
    "actions": "read",
    "checks": "write",
    "contents": "read",
    "issues": "read",
    "metadata": "read",
    "pull_requests": "write"
  },
  "default_events": [
    "check_run",
    "check_suite",
    "installation",
    "installation_repositories",
    "issue_comment",
    "pull_request"
  ]
}
