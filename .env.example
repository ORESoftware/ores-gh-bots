# Webhook listener. Keep the HTTP ingress budgets explicit so slow or
# header-heavy clients cannot occupy sockets indefinitely before validation.
PORT=8080
BODY_LIMIT_BYTES=2000000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_HEADER_BYTES=16384
HTTP_MAX_HEADERS_COUNT=64
HTTP_MAX_REQUESTS_PER_SOCKET=100
GITHUB_WEBHOOK_SECRET=replace-with-generated-webhook-secret
OWNER_ALLOWLIST=ORESoftware

# Orchestrator GitHub App
GITHUB_APP_ID=replace-with-orchestrator-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-orchestrator-private-key-pem-using-literal-backslash-n

# Separate GitHub Apps are required by default so provider and gate checks are
# pinned to independent identities. Set this true only for local development.
ALLOW_SHARED_APP_IDENTITY=false
OPENAI_REVIEW_APP_ID=replace-with-openai-reviewer-app-id
OPENAI_REVIEW_APP_PRIVATE_KEY=replace-with-openai-reviewer-private-key-pem-using-literal-backslash-n
CLAUDE_REVIEW_APP_ID=replace-with-claude-reviewer-app-id
CLAUDE_REVIEW_APP_PRIVATE_KEY=replace-with-claude-reviewer-private-key-pem-using-literal-backslash-n
GATE_APP_ID=replace-with-review-gate-app-id
GATE_APP_PRIVATE_KEY=replace-with-review-gate-private-key-pem-using-literal-backslash-n
ACTIONS_APP_ID=replace-with-actions-dispatcher-app-id
ACTIONS_APP_PRIVATE_KEY=replace-with-actions-dispatcher-private-key-pem-using-literal-backslash-n

# Dedicated fleet merge identity. This App is not the webhook orchestrator and
# owns only the exact-SHA merge effects performed by the nightly reaper.
MERGE_REAPER_APP_ID=replace-with-merge-reaper-app-id
MERGE_REAPER_APP_PRIVATE_KEY=replace-with-merge-reaper-private-key-pem-using-literal-backslash-n

# Provider API credentials and models. API keys are sent only to HTTPS origins
# in this allowlist. Add a reviewed proxy origin explicitly before changing a
# provider base URL; allowlist entries must be bare HTTPS origins.
PROVIDER_ALLOWED_ORIGINS=https://api.openai.com,https://api.anthropic.com
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_MAX_OUTPUT_TOKENS=16000
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=16000

# Review policy
REQUIRED_CI_CONTEXTS=ci/verify
# Optional comma-separated context=GitHub-App-ID pins. Every mapped context
# must also appear in REQUIRED_CI_CONTEXTS.
REQUIRED_CI_APP_IDS=ci/verify=replace-with-ci-github-app-id
MAX_DIFF_BYTES=500000
MAX_FILE_BYTES=80000
MAX_FILES=200
MAX_FINDINGS=30
REVIEW_TIMEOUT_MS=180000
QUEUE_PATH=/data/ores-gh-bots.sqlite
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_MS=600000

# Optional GitHub Actions offload/dispatch lane
GHA_MODE=supplemental
# Prefer ACTIONS_APP_ID/ACTIONS_APP_PRIVATE_KEY. PAT fallback only:
GHA_DISPATCH_TOKEN=
# Optional installation hint; the Actions App installation is discovered and
# verified against GHA_REPOSITORY when this is empty.
GHA_INSTALLATION_ID=
GHA_REPOSITORY=ORESoftware/ores-gh-bots
GHA_WORKFLOW_ID=review-dispatch.yml
GHA_REF=main

# Fail-closed nightly merge reaper. Apply mode also requires an explicit
# MERGE-* acknowledgement; the checked-in schedule supplies its reviewed ticket.
MERGE_REAPER_POLICY=config/merge-reaper.example.json
MERGE_REAPER_MIN_AGE_HOURS=55
MERGE_REAPER_MAX_MERGES=3
MERGE_REAPER_MAX_REPOSITORIES=2000
MERGE_REAPER_MAX_PRS_PER_REPOSITORY=100
MERGE_REAPER_OUTPUT=merge-reaper-report.json
