# Webhook listener
PORT=8080
GITHUB_WEBHOOK_SECRET=replace-me
OWNER_ALLOWLIST=ORESoftware

# Orchestrator GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional separate GitHub Apps so required checks are pinned to distinct identities.
OPENAI_REVIEW_APP_ID=
OPENAI_REVIEW_APP_PRIVATE_KEY=
CLAUDE_REVIEW_APP_ID=
CLAUDE_REVIEW_APP_PRIVATE_KEY=
GATE_APP_ID=
GATE_APP_PRIVATE_KEY=
ACTIONS_APP_ID=
ACTIONS_APP_PRIVATE_KEY=

# Provider API credentials and models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Review policy
REQUIRED_CI_CONTEXTS=
MAX_DIFF_BYTES=500000
MAX_FILE_BYTES=80000
MAX_FILES=200
MAX_FINDINGS=30
REVIEW_TIMEOUT_MS=180000
QUEUE_PATH=/data/ores-gh-bots.sqlite
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_MS=600000

# Optional GitHub Actions offload/dispatch lane
GHA_MODE=supplemental
# Prefer ACTIONS_APP_ID/ACTIONS_APP_PRIVATE_KEY. PAT fallback only:
GHA_DISPATCH_TOKEN=
GHA_INSTALLATION_ID=
GHA_REPOSITORY=ORESoftware/ores-gh-bots
GHA_WORKFLOW_ID=review-dispatch.yml
GHA_REF=main
